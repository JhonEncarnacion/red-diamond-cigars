{
  "name": "red-diamond-cigars",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "test:rate-limit": "node --import tsx --test tests/inquiry-rate-limit.test.ts",
    "db:setup-rate-limit": "prisma db execute --file prisma/sql/add-inquiry-rate-limit.sql",
    "images:generate": "node scripts/generate-public-images.mjs",
    "predev": "npm run images:generate",
    "prebuild": "npm run images:generate",
    "test:images": "node --import tsx --test tests/product-images.test.ts",
    "db:add-packaging": "prisma db execute --file prisma/sql/add-product-packaging.sql",
    "db:remove-stock": "prisma db execute --file prisma/sql/remove-product-stock.sql",
    "test:catalog": "node --import tsx --test tests/product-catalog.test.ts",
    "db:preserve-inquiries": "prisma db execute --file prisma/sql/preserve-product-inquiries.sql",
    "test:deletion": "node --import tsx --test tests/independent-deletion.test.ts",
    "test:i18n": "node --import tsx --test tests/i18n.test.ts",
    "db:add-translations": "prisma db execute --file prisma/sql/add-product-translations.sql"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.5.2",
    "@hookform/resolvers": "^5.4.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.17.0",
    "motion": "^12.42.2",
    "next": "16.2.7",
    "next-intl": "^4.14.9",
    "pg": "^8.21.0",
    "prisma": "^7.8.0",
    "radix-ui": "^1.5.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.78.0",
    "resend": "^6.12.4",
    "shadcn": "^4.11.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5"
  }
}
